SERVER_URL=https://my.mailbux.com
DOMAIN_REDIRECT_URL=https://localhost:8080
WEB_OIDC_CLIENT_ID=mailbux-web
MOBILE_OIDC_CLIENT_ID=mailbux-mobile
OIDC_SCOPES=openid,offline_access
# Scopos: skip the provider hosted login page, use the in-app credential form
DISABLE_OIDC=true
# App grid (Mail/Drive/Calendar/Contacts launcher) off: Scopos uses this
# as a mail client only, and the other apps are the vendor's.
APP_GRID_AVAILABLE=unsupported
FCM_AVAILABLE=supported
IOS_FCM=supported
FORWARD_WARNING_MESSAGE=
PLATFORM=other
WS_ECHO_PING=
COZY_INTEGRATION=